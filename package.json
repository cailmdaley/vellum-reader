{
  "name": "vellum-reader",
  "version": "0.1.0",
  "description": "A static reader for felt fibers. Adapter-driven, MyST-rendered.",
  "type": "module",
  "license": "MIT",
  "author": "Cail Daley",
  "homepage": "https://github.com/cailmdaley/vellum-reader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cailmdaley/vellum-reader.git"
  },
  "bugs": {
    "url": "https://github.com/cailmdaley/vellum-reader/issues"
  },
  "keywords": [
    "felt",
    "myst",
    "reader",
    "fibers",
    "static-site",
    "knowledge-base"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./adapter": "./src/adapter.ts",
    "./css": "./src/vellum.css"
  },
  "files": [
    "src",
    "dist",
    "public",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --port 3200",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview --port 3200",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@myst-theme/providers": "^1.2.0",
    "@replit/codemirror-vim": "^6.3.0",
    "katex": "^0.16.45",
    "myst-to-react": "^1.2.0",
    "pdfjs-dist": "^5.6.205",
    "react-router-dom": "^6.30.1",
    "react-tweet": "^3.3.0"
  },
  "devDependencies": {
    "@types/lodash.throttle": "^4.1.9",
    "@types/react": "^18.2.24",
    "@types/react-dom": "^18.2.8",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.1.6",
    "vite": "^7.1.7",
    "vitest": "2.1.9"
  }
}
